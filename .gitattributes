# ============================================================
#  Line-ending & content normalization
#  (repo is edited on Windows; keep the INDEX as LF and the
#   working tree sane so nightly auto-commits don't churn)
# ============================================================

# Default: detect text, store LF.
* text=auto eol=lf

# Windows-native scripts -> CRLF in the working tree.
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.psd1   text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Shell / hook scripts -> MUST stay LF or `sh` will fail.
*.sh     text eol=lf
.githooks/* text eol=lf

# Config / docs / web -> LF.
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.svg     text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Binary assets -> never convert.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.tar   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
